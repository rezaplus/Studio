# Copy to .env (or use Studio > Settings). Never commit .env or paste it into chat.

# Transport per provider: api (scripts + keys below) or mcp (agent MCP tools, sign in with /mcp). Default: api.
HIGGSFIELD_MODE=api
HEYGEN_MODE=api

# Higgsfield API (only needed in api mode)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HF_API_BASE_URL=https://api.higgsfield.ai
HF_MODEL=bytedance/seedance-2.0/text-to-video
HF_POLL_INTERVAL_SECONDS=10
HF_MAX_WAIT_SECONDS=1800

# HeyGen API (only needed in api mode)
HEYGEN_API_KEY=
